# Copy this file to .env and replace every example value.
APP_NAME=Alias Ticketing
APP_ENV=development
API_PREFIX=/api
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:4200

# Primary local setup: SQL Server's default instance with Windows Authentication
# through ODBC Driver 18. The URL therefore contains no database credentials.
# ODBC Driver 18 encrypts by default. TrustServerCertificate=yes is suitable only
# for a local development instance with a self-signed certificate. For shared,
# remote, or production SQL Server, use a trusted certificate and remove it.
DATABASE_URL=mssql+pyodbc://@localhost/alias_ticketing?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes&trusted_connection=yes

# Alternative: SQL Server Authentication. Put the real login only in the local
# .env file and URL-encode its name and password; never commit those credentials.
# DATABASE_URL=mssql+pyodbc://SQL_LOGIN_NAME:URL_ENCODED_PASSWORD@localhost/alias_ticketing?driver=ODBC+Driver+18+for+SQL+Server&Encrypt=yes&TrustServerCertificate=yes
AUTO_CREATE_TABLES=false

# Explicitly opt into the lightweight SQLite demo database only when SQL Server
# is unavailable for local classroom demonstrations.
# DATABASE_URL=sqlite:///./ticketing.db
# AUTO_CREATE_TABLES=true

# Optional one-time bootstrap administrator. Never use a real password here in
# source control; put it only in the local .env file.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=System
BOOTSTRAP_ADMIN_LAST_NAME=Administrator
